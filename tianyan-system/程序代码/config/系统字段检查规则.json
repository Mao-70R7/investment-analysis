  "aiStrategyTwoStageChecks": {
    "ruleId": "AI_STRATEGY_TWO_STAGE_PROTOCOL_INVALID",
    "asset": "assets/ai-strategy.js",
    "requiredFunctions": [
      "businessRoutingPromptCatalog",
      "requestModelRoute",
      "hydrateBusinessRoute",
      "requestModelIntent",
      "modelFilterFieldNames"
    ],
    "requiredCallSequence": [
      "await requestModelRoute(queryText)",
      "await requestModelIntent(queryText, route)"
    ],
    "maximumModelCallsPerExecution": 2,
    "forbiddenPromptFragments": [
      "可用字段：${filterFieldNames().map",
      "首次结果为空后再次整句复核"
    ],
    "businessRouteForbiddenFields": [
      "统一策略ID",
      "策略代码",
      "母策略ID",
      "官方业绩来源策略ID",
      "业绩基准来源策略ID",
      "detailFile",
      "searchText"
    ],
    "说明": "第一轮模型只能接收业务实体核心框架；第二轮只接收相关实体字段卡。技术ID、文件路径和全量字段不得进入模型提示词，第二轮失败后不得追加第三次调用。"
  },
  "aiStrategyDateValueChecks": {
    "ruleId": "AI_STRATEGY_DATE_VALUE_NORMALIZATION_INVALID",
    "asset": "assets/ai-strategy.js",
    "requiredFunctions": [
      "calendarMonthsAgo",
      "relativeDateBoundary",
      "establishedRelativeDateCondition",
      "explicitDateOperator",
      "explicitDateFilters",
      "normalizeDateFilterValue",
      "normalizeParsedDateFilters"
    ],
    "requiredFragments": [
      "查询基准日期：${dateText(asOfDate())}",
      "valueFormat: dataType === \"date\" ? \"YYYY-MM-DD\"",
      "explicitDateFilters(query).forEach((filter) => addGenericFilter(parsed, filter));",
      "aliases: [\"成立日期\", \"成立时间\", \"成立日\", \"设立日期\", \"设立时间\", \"设立日\"]",
      "normalizeParsedDateFilters(parsed);",
      "无法转换为 YYYY-MM-DD，已拒绝执行该条件"
    ],
    "minimumNormalizationCallCount": 3,
    "说明": "相对日期必须由本地确定性逻辑按查询基准日换算为 YYYY-MM-DD；业务字段+中文运算符+明确日期必须直接本地解析；模型原文和手工输入都不得绕过日期类型归一直接参与比较。"
  },
  "aiStrategyPerformanceScopeChecks": {
    "ruleId": "AI_STRATEGY_PERFORMANCE_SCOPE_INVALID",
    "asset": "assets/ai-strategy.js",
    "requiredFunctions": [
      "isPerformanceCompleteStrategy"
    ],
    "requiredFragments": [
      "row?.业绩完整 === \"是\"",
      "{ field: \"业绩完整\", op: \"=\", value: \"是\", label: \"仅业绩完整策略\", system: true }",
      "base = base.filter(isPerformanceCompleteStrategy)",
      "return latest || new Date();",
      "const drawableRows = (rows || []).map",
      "const sourceRows = drawableRows.slice(0, 500);"
    ],
    "forbiddenFragments": [
      "function isCompleteStrategy(row)",
      "label: \"仅完整可比数据\"",
      "base.filter(isCompleteStrategy)",
      "(rows || []).slice(0, 500).map"
    ],
    "说明": "AI选策略默认候选池只以业绩完整为门槛，不得把基准、仓位或回放完整性作为隐藏前置条件；相对日期以页面数据基准日计算，点阵必须先识别全部可绘制候选再执行500条展示上限。"
  },
