{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianyan.local/schema/ai-strategy-business-semantic-model.v2.schema.json",
  "title": "AI选策略业务语义实体模型 Schema v2",
  "description": "以业务实体、事实类型、数据粒度、字典契约、执行绑定和质量血缘为中心的通用语义模型。页面宽表只是可执行投影，不作为业务本体。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "catalogVersion",
    "status",
    "snapshot",
    "businessFramework",
    "entityTypes",
    "factKinds",
    "subjectAreas",
    "dictionaryContract",
    "semanticCatalog",
    "physicalFieldMappings",
    "virtualFieldMappings",
    "graphEdges",
    "progressiveProtocol",
    "qualityPolicy",
    "designConstraints",
    "migration"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "ai_strategy_business_semantic_model" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposal", "approved", "active", "retired"] },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "businessFramework": { "$ref": "#/$defs/businessFramework" },
    "entityTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entityType" }
    },
    "factKinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/factKind" }
    },
    "subjectAreas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/subjectArea" }
    },
    "dictionaryContract": { "$ref": "#/$defs/dictionaryContract" },
    "semanticCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "operatorProfiles", "concepts"],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/domain" }
        },
        "operatorProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operatorProfile" }
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/concept" }
        }
      }
    },
    "physicalFieldMappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fieldMapping" }
    },
    "virtualFieldMappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/virtualFieldMapping" }
    },
    "graphEdges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "progressiveProtocol": { "$ref": "#/$defs/progressiveProtocol" },
    "qualityPolicy": { "$ref": "#/$defs/qualityPolicy" },
    "designConstraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "migration": { "$ref": "#/$defs/migration" }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageArtifactAsOf",
        "databaseInspectedAt",
        "sourceArtifact",
        "pageStrategyCount",
        "databaseStrategyCount",
        "physicalFieldCount",
        "virtualFieldCount",
        "dictionaryDescribedFieldCount",
        "dictionaryMissingFieldCount",
        "coverageSummary",
        "coreTableProfiles"
      ],
      "properties": {
        "pageArtifactAsOf": { "type": "string", "format": "date-time" },
        "databaseInspectedAt": { "type": "string", "format": "date-time" },
        "sourceArtifact": { "type": "string", "minLength": 1 },
        "pageStrategyCount": { "type": "integer", "minimum": 0 },
        "databaseStrategyCount": { "type": "integer", "minimum": 0 },
        "physicalFieldCount": { "type": "integer", "minimum": 1 },
        "virtualFieldCount": { "type": "integer", "minimum": 0 },
        "dictionaryDescribedFieldCount": { "type": "integer", "minimum": 0 },
        "dictionaryMissingFieldCount": { "type": "integer", "minimum": 0 },
        "coverageSummary": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "dictionaryMissingFields": { "$ref": "#/$defs/stringArray" },
        "emptyPhysicalFields": { "$ref": "#/$defs/stringArray" },
        "coreTableProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table", "rowCount", "grain"],
            "properties": {
              "table": { "type": "string", "minLength": 1 },
              "rowCount": { "type": "integer", "minimum": 0 },
              "grain": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "businessFramework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootTarget", "projectionPolicy", "layers", "relationshipTypes", "timeAxes"],
      "properties": {
        "rootTarget": { "type": "string", "minLength": 1 },
        "projectionPolicy": { "type": "string", "minLength": 1 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "purpose", "nodeTypes"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "nodeTypes": { "$ref": "#/$defs/stringArray" }
            }
          }
        },
        "relationshipTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "fromEntityType", "toEntityType", "cardinality", "businessMeaning"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "fromEntityType": { "type": "string", "minLength": 1 },
              "toEntityType": { "type": "string", "minLength": 1 },
              "cardinality": { "enum": ["1:1", "1:N", "N:1", "N:M"] },
              "businessMeaning": { "type": "string", "minLength": 1 }
            }
          }
        },
        "timeAxes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "definition"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "definition": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "entityType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "entityClass", "businessDefinition", "sourceTables", "primaryKey", "grain"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "entityClass": { "enum": ["master", "relationship", "observation", "snapshot", "position", "event", "event_detail", "policy", "classification", "evidence", "projection"] },
        "businessDefinition": { "type": "string", "minLength": 1 },
        "sourceTables": { "$ref": "#/$defs/stringArray" },
        "primaryKey": { "$ref": "#/$defs/stringArray" },
        "grain": { "type": "string", "minLength": 1 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "parentEntityTypes": { "$ref": "#/$defs/stringArray" },
        "qualityNotes": { "type": "string" }
      }
    },
    "factKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "definition", "requiredMetadata"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "requiredMetadata": { "$ref": "#/$defs/stringArray" }
      }
    },
    "subjectArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "entityTypeIds", "factKindIds", "conceptNamespaces"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "entityTypeIds": { "$ref": "#/$defs/stringArray" },
        "factKindIds": { "$ref": "#/$defs/stringArray" },
        "conceptNamespaces": { "$ref": "#/$defs/stringArray" },
        "defaultTargetEntity": { "type": "string" }
      }
    },
    "dictionaryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requiredMetadataKeys", "metadataDimensions", "nullSemantics", "versioningPolicy"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "requiredMetadataKeys": { "$ref": "#/$defs/stringArray" },
        "metadataDimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "purpose", "owner"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "owner": { "enum": ["business", "data", "semantic", "execution", "quality"] }
            }
          }
        },
        "nullSemantics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "meaning", "filterBehavior"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "meaning": { "type": "string", "minLength": 1 },
              "filterBehavior": { "type": "string", "minLength": 1 }
            }
          }
        },
        "versioningPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "retrievalPriority"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "retrievalPriority": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "operatorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valueType", "allowedOperators", "valueFormat", "normalizationRules"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "valueType": { "$ref": "#/$defs/fieldType" },
        "allowedOperators": { "$ref": "#/$defs/stringArray" },
        "valueFormat": { "type": "string", "minLength": 1 },
        "normalizationRules": { "$ref": "#/$defs/stringArray" }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "domainId", "subjectAreaId", "entityTypeId", "factKindId", "conceptType",
        "businessDefinition", "defaultGrain", "operatorProfileId", "semanticVisibility", "aliases",
        "positiveCues", "negativeCues", "confusableWith"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "domainId": { "type": "string", "minLength": 1 },
        "subjectAreaId": { "type": "string", "minLength": 1 },
        "entityTypeId": { "type": "string", "minLength": 1 },
        "factKindId": { "type": "string", "minLength": 1 },
        "conceptType": { "enum": ["attribute", "measure", "relationship", "event", "evidence", "entity_binding", "technical"] },
        "businessDefinition": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "defaultGrain": { "type": "string", "minLength": 1 },
        "operatorProfileId": { "type": "string", "minLength": 1 },
        "semanticVisibility": { "$ref": "#/$defs/semanticVisibility" },
        "aliases": { "$ref": "#/$defs/stringArray" },
        "positiveCues": { "$ref": "#/$defs/stringArray" },
        "negativeCues": { "$ref": "#/$defs/stringArray" },
        "confusableWith": { "$ref": "#/$defs/stringArray" },
        "applicability": { "$ref": "#/$defs/stringArray" },
        "entityGraphDimensions": { "$ref": "#/$defs/stringArray" },
        "notes": { "type": "string" }
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldName", "conceptId", "entityTypeId", "factKindId", "grain", "subjectPath", "fieldType",
        "semanticRole", "semanticVisibility", "executionStatus", "dictionaryStatus"
      ],
      "properties": {
        "fieldName": { "type": "string", "minLength": 1 },
        "conceptId": { "type": "string", "minLength": 1 },
        "entityTypeId": { "type": "string", "minLength": 1 },
        "factKindId": { "type": "string", "minLength": 1 },
        "grain": { "type": "string", "minLength": 1 },
        "subjectPath": { "type": "string", "minLength": 1 },
        "fieldType": { "$ref": "#/$defs/fieldType" },
        "semanticRole": { "$ref": "#/$defs/semanticRole" },
        "semanticVisibility": { "$ref": "#/$defs/semanticVisibility" },
        "executionStatus": { "$ref": "#/$defs/executionStatus" },
        "dictionaryStatus": { "enum": ["documented", "incomplete", "missing"] },
        "dictionaryDocumented": { "type": "boolean" },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "unit": { "type": "string" },
        "availabilityBucket": { "enum": ["full", "high", "medium", "low", "very_low", "near_zero", "empty"] },
        "timeAxis": { "type": "string" },
        "sourceBinding": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "virtualFieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldName", "conceptId", "entityTypeId", "factKindId", "grain", "subjectPath", "fieldType",
        "semanticRole", "semanticVisibility", "executionStatus", "dictionaryStatus", "derivation"
      ],
      "properties": {
        "fieldName": { "type": "string", "minLength": 1 },
        "conceptId": { "type": "string", "minLength": 1 },
        "entityTypeId": { "type": "string", "minLength": 1 },
        "factKindId": { "type": "string", "minLength": 1 },
        "grain": { "type": "string", "minLength": 1 },
        "subjectPath": { "type": "string", "minLength": 1 },
        "fieldType": { "$ref": "#/$defs/fieldType" },
        "semanticRole": { "$ref": "#/$defs/semanticRole" },
        "semanticVisibility": { "$ref": "#/$defs/semanticVisibility" },
        "executionStatus": { "$ref": "#/$defs/executionStatus" },
        "dictionaryStatus": { "enum": ["documented", "incomplete", "missing"] },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "unit": { "type": "string" },
        "timeAxis": { "type": "string" },
        "derivation": { "type": "string", "minLength": 1 },
        "sourceFields": { "$ref": "#/$defs/stringArray" },
        "notes": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type", "to", "purpose"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "is_a", "part_of", "maps_to", "derived_from", "confusable_with", "requires", "gates",
            "supports", "same_value_as", "entity_dimension_of", "candidate_for", "belongs_to", "observes", "references"
          ]
        },
        "to": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "progressiveProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principles", "stages", "parallelPolicy", "clarificationPolicy", "cachePolicy"],
      "properties": {
        "principles": { "$ref": "#/$defs/stringArray" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sequence", "label", "executor", "scope", "input", "output", "guardrails"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "sequence": { "type": "integer", "minimum": 0 },
              "label": { "type": "string", "minLength": 1 },
              "executor": { "enum": ["deterministic", "model", "retrieval", "compiler", "database"] },
              "scope": { "enum": ["request", "clause", "global"] },
              "input": { "$ref": "#/$defs/stringArray" },
              "output": { "$ref": "#/$defs/stringArray" },
              "candidateLimit": { "type": "integer", "minimum": 1 },
              "guardrails": { "$ref": "#/$defs/stringArray" }
            }
          }
        },
        "parallelPolicy": { "type": "string", "minLength": 1 },
        "clarificationPolicy": { "type": "string", "minLength": 1 },
        "cachePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "qualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualityStates", "executionRules", "explanationRequirements"],
      "properties": {
        "qualityStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "meaning", "executionBehavior"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
              "meaning": { "type": "string", "minLength": 1 },
              "executionBehavior": { "type": "string", "minLength": 1 }
            }
          }
        },
        "executionRules": { "$ref": "#/$defs/stringArray" },
        "explanationRequirements": { "$ref": "#/$defs/stringArray" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromArtifact", "changeType", "breakingChanges", "compatibilityPolicy", "implementationOrder"],
      "properties": {
        "fromArtifact": { "type": "string", "minLength": 1 },
        "changeType": { "enum": ["non_breaking", "breaking", "mixed"] },
        "breakingChanges": { "$ref": "#/$defs/stringArray" },
        "compatibilityPolicy": { "type": "string", "minLength": 1 },
        "implementationOrder": { "$ref": "#/$defs/stringArray" }
      }
    },
    "fieldType": {
      "enum": ["identifier", "text", "enum", "boolean", "integer", "number", "percent", "date", "path", "search_text"]
    },
    "semanticRole": {
      "enum": ["primary", "variant", "source_variant", "derived", "evidence", "technical", "current_duplicate", "quality_gate"]
    },
    "semanticVisibility": {
      "enum": ["direct_filter", "advanced_filter", "conditional", "evidence_only", "audit_only"]
    },
    "executionStatus": {
      "enum": ["active", "conditional", "evidence_only", "audit_only", "inactive_no_data"]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
